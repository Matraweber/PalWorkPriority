
# Runtime output written next to the deployed mod
# Workshop upload state; publishedfileid is per-publisher
*.zip
.workshop.json
Discovery.txt
Stock.txt
build/
priorities.txt
priority.log

# Python bytecode. These were tracked by accident and embed the absolute
# source path of whoever compiled them, which is how a user name ended up in
# the repository in a file no text search would find.
__pycache__/
*.pyc
.test-deps/
test-results/
.tmp/assignment-census/

# Local macro run logs; they record the private server address
tools/*-last-run.log

# Obsidian (docs/ is a vault): per-device state stays local
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.obsidian/appearance.json
docs/.obsidian/graph.json
docs/.trash/
